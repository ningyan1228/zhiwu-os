SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-secret
ALLOWED_ORIGINS=https://your-github-user.github.io,http://localhost:5173
MAIL_HOST=imap.qiye.aliyun.com
MAIL_PORT=993
MAIL_USERNAME=your-business-email@example.com
MAIL_PASSWORD=server-only-imap-password-or-app-password
MAIL_FOLDER=INBOX
MAIL_OWNER_USER_ID=your-supabase-auth-user-id
MAIL_SYNC_INTERVAL_SECONDS=600
MAIL_SYNC_MAX_MESSAGES=100
# Optional documented server-side search API token. Never put this in the frontend
# or a public GitHub repository. Without it, lead discovery can still use approved
# public exhibitor/association/business-directory URLs stored per task.
BRAVE_SEARCH_API_KEY=

# Optional OpenAI-compatible analysis. Keep these server-only. Rules remain
# fully functional if AI_ENABLED is false or the values are blank.
AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
LEAD_DISCOVERY_USER_AGENT=ZhiwuOSLeadDiscovery/1.0 (+https://your-domain.example/contact)
LEAD_DISCOVERY_DELAY_SECONDS=3
CRAWLER_MAX_PAGES_PER_DOMAIN=8
CRAWLER_REQUEST_TIMEOUT_SECONDS=20
